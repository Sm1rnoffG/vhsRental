CREATE TABLE movie (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    length INTEGER NOT NULL,
    available_copies INTEGER NOT NULL,
    currently_available INTEGER NOT NULL,
    format INTEGER NOT NULL,
    age_rating INTEGER NOT NULL,
    image_url TEXT NOT NULL,
    imdb_url TEXT NOT NULL,
    release_year INTEGER NOT NULL,
    description TEXT NOT NULL,
    genre INTEGER NOT NULL
);

selectAll:
SELECT *
FROM movie
ORDER BY name;

deleteMovie:
DELETE FROM movie
WHERE id = ?;

getMovie:
SELECT * FROM movie
WHERE id = ?;

addMovie:
INSERT OR REPLACE INTO movie (
    id,
    name,
    length,
    available_copies,
    currently_available,
    format,
    age_rating,
    image_url,
    imdb_url,
    release_year,
    description,
    genre
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

INSERT OR REPLACE INTO movie(
      id,
      name,
      length,
      available_copies,
      currently_available,
      format,
      age_rating,
      image_url,
      imdb_url,
      release_year,
      description,
      genre
) VALUES (0, "Up", 96, 1, 1, 0, 3, "https://image.tmdb.org/t/p/original/nlV35BhheFq9QqIdiL8aMCa3zAm.jpg", "https://www.imdb.com/title/tt1049413/", 2009, "78-year-old Carl Fredricksen travels to Paradise Falls in his house equipped with balloons, inadvertently taking a young stowaway.", 3),
(1, "Terminator", 107, 4, 4, 1, 15, "https://image.tmdb.org/t/p/original/km2OqfSlv9vnqNDCF3w99Y4T5go.jpg", "https://www.imdb.com/title/tt0088247/", 1984, "A human soldier is sent from 2029 to 1984 to stop an almost indestructible cyborg killing machine, sent from the same year, which has been programmed to execute a young woman whose unborn son is the key to humanity's future salvation.", 0),
(2, "Titanic", 194, 2, 2, 3, 12, "https://image.tmdb.org/t/p/original/nlV35BhheFq9QqIdiL8aMCa3zAm.jpg", "https://www.imdb.com/title/tt0120338/", 1997, "A seventeen-year-old aristocrat falls in love with a kind but poor artist aboard the luxurious, ill-fated R.M.S. Titanic.", 1),
(3, "The Shining", 146, 1, 1, 1, 18, "https://image.tmdb.org/t/p/original/nRj5511mZdTl4saWEPoj9QroTIu.jpg", "https://www.imdb.com/title/tt0081505/", 1980, "A family heads to an isolated hotel for the winter where a sinister presence influences the father into violence, while his psychic son sees horrific forebodings from both past and future.", 2),
