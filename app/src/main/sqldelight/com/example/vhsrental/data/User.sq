CREATE TABLE user (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    surname TEXT NOT NULL,
    email TEXT NOT NULL,
    password BLOB NOT NULL,
    role INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT *
FROM user
ORDER BY id;

deleteUser:
DELETE FROM user
WHERE id = ?;

updateAccount:
INSERT OR REPLACE INTO user(
    id,
    name,
    surname,
    email,
    password,
    role
)
VALUES (?, ?, ?, ?, ?, ?);

getUser:
SELECT * FROM user
WHERE id = ?;

getUserByEmail:
SELECT * FROM user
WHERE email = ?;

addUser:
INSERT OR ABORT INTO user (
    id,
    name,
    surname,
    email,
    password,
    role
)
VALUES (?, ?, ?, ?, ?, ?);

