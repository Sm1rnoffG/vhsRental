CREATE TABLE user (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    surname TEXT NOT NULL,
    email TEXT NOT NULL,
    password BLOB NOT NULL,
    role INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT *
FROM user
ORDER BY id;

findUserByEmail:
SELECT *
FROM user
WHERE email = ?;

deleteUser:
DELETE FROM user
WHERE id = ?;

addUser:
INSERT OR ABORT INTO user (
    id,
    name,
    surname,
    email,
    password,
    role
)
VALUES (?, ?, ?, ?, ?, ?);

