CREATE TABLE rentalOrder (
    id INTEGER PRIMARY KEY NOT NULL,
    state INTEGER NOT NULL,
    create_date TEXT NOT NULL,
    return_date TEXT,
    user_id INTEGER NOT NULL,
    movie_id INTEGER NOT NULL
);

selectAll:
SELECT *
FROM rentalOrder
ORDER BY id;

deleteOrder:
DELETE FROM rentalOrder
WHERE id = ?;

selectUsersOrders:
SELECT *
FROM rentalOrder
WHERE user_id = ?
ORDER BY return_date DESC;

getOrder:
SELECT * FROM rentalOrder
WHERE id = ?;

createOrder:
INSERT OR REPLACE INTO rentalOrder (
    id,
    state,
    create_date,
    return_date,
    user_id,
    movie_id
)
VALUES (?, ?, ?, ?, ?, ?);
