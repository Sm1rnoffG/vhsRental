CREATE TABLE rental_order (
    id INTEGER PRIMARY KEY NOT NULL,
    state INTEGER NOT NULL,
    create_date TEXT NOT NULL,
    return_date TEXT,
    user_id INTEGER NOT NULL,
    movie_id INTEGER NOT NULL
);

selectAll:
SELECT *
FROM rental_order
ORDER BY id;

createOrder:
INSERT OR ABORT INTO rental_order (
    id,
    state,
    create_date,
    return_date,
    user_id,
    movie_id
)
VALUES (?, ?, ?, ?, ?, ?);
